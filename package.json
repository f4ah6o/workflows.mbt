{
  "name": "@f4ah6o/workflows-mbt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "workflows": "./host/cli.mjs"
  },
  "scripts": {
    "check:moon": "moon check --target js",
    "build:core": "node scripts/build-core.mjs",
    "test:moon": "moon test --target js",
    "test:host": "node --test tests/host.test.mjs",
    "test:e2e": "node --test tests/e2e.test.mjs",
    "test": "npm run check:moon && npm run build:core && npm run test:moon && npm run test:host && npm run test:e2e",
    "compat:typecheck": "tsc -p compat/typecheck/tsconfig.json",
    "compat:pinned": "npm run compat:typecheck && node compat/oracle/check.mjs --mode pinned && node compat/run-differential.mjs --oracle pinned && node compat/check-capabilities.mjs --require-pinned",
    "compat:latest": "node compat/run-latest.mjs && node compat/check-capabilities.mjs --require-latest",
    "compat:report": "node compat/report.mjs",
    "compat:drill": "node compat/run-drill.mjs",
    "check:toolchain": "node scripts/check-toolchain.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "esbuild": "^0.25.10",
    "jsonc-parser": "^3.3.1"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260925.2",
    "typescript": "^5.9.3",
    "workerd": "1.20260925.2",
    "wrangler": "4.141.0"
  }
}
