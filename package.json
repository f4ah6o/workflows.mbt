{
  "name": "@f4ah6o/workflows-mbt",
  "version": "0.1.0",
  "private": true,
  "description": "Local durable-execution runtime compatible with Cloudflare Workflows \u2014 dependency insurance and fallback execution for existing workflow source.",
  "type": "module",
  "bin": {
    "workflows": "./host/cli.mjs"
  },
  "files": [
    "dist",
    "host",
    "compat",
    "fixtures",
    "docs",
    "examples",
    "scripts",
    "src",
    "moon.mod.json",
    ".moonbit-toolchain.json",
    "npm-shrinkwrap.json",
    "!**/.workflows",
    "!**/.workflows/**",
    "!**/.wrangler",
    "!**/.wrangler/**",
    "!**/*.db",
    "!**/*.db-shm",
    "!**/*.db-wal",
    "!**/.dev.vars*",
    "!**/.env*",
    "!**/compat-results",
    "!**/compat-results/**"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/f4ah6o/workflows.mbt.git"
  },
  "scripts": {
    "check:moon": "moon check --target js",
    "build:core": "node scripts/build-core.mjs",
    "test:moon": "moon test --target js",
    "test:host": "node --test tests/host.test.mjs",
    "test:storage": "node --test tests/storage.test.mjs",
    "test:e2e": "node --test tests/e2e.test.mjs",
    "test": "npm run check:moon && npm run build:core && npm run test:moon && npm run test:host && npm run test:storage && npm run test:compat && npm run test:upstream-ops && npm run test:inventory && npm run test:coverage && npm run test:upstream-coverage && npm run test:e2e",
    "test:consumer": "node scripts/consumer-smoke.mjs",
    "compat:typecheck": "tsc -p compat/typecheck/tsconfig.json",
    "compat:pinned": "npm run compat:typecheck && node compat/oracle/check.mjs --mode pinned && node compat/run-differential.mjs --oracle pinned && node compat/check-capabilities.mjs --require-pinned",
    "compat:latest": "node compat/run-latest.mjs && node compat/check-capabilities.mjs --require-latest",
    "compat:report": "node compat/report.mjs",
    "compat:coverage": "node compat/coverage.mjs",
    "compat:upstream-coverage": "node compat/upstream-coverage.mjs",
    "compat:drill": "node compat/run-drill.mjs",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "test:compat": "node --test tests/compat-probe-client.test.mjs tests/release-pin.test.mjs",
    "prepack": "node scripts/prepare-pack.mjs",
    "postpack": "node scripts/prepare-pack.mjs --cleanup",
    "test:scenario": "node scripts/consumer-scenario.mjs",
    "test:upstream-ops": "node --test tests/upstream-ops.test.mjs",
    "test:inventory": "node --test tests/coverage-inventory.test.mjs",
    "test:coverage": "node --test tests/coverage-pipeline.test.mjs",
    "test:upstream-coverage": "node --test tests/upstream-coverage.test.mjs",
    "check:inventory": "node compat/check-inventory.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "esbuild": "^0.25.10",
    "jsonc-parser": "^3.3.1"
  },
  "optionalDependencies": {
    "pg": "^8.23.0"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260925.2",
    "typescript": "^5.9.3",
    "workerd": "1.20260925.2",
    "wrangler": "4.141.0"
  }
}
